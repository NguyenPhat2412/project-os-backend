<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>vn.uytinmang.projectos</groupId>
        <artifactId>project-os-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>monolith-service</artifactId>
    <name>Project OS Monolith Service</name>
    <description>Unified Monolith Backend Service for Project OS running on Port 8080</description>

    <dependencies>
        <!-- Platform Common & Core -->
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>resource-service-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Domain Microservice Modules (Aggregated) -->
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>identity-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>organization-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>attendance-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>project-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>work-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>operations-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>knowledge-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>vn.uytinmang.projectos</groupId>
            <artifactId>activity-service</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI / Swagger -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Database & Flyway -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>vn.uytinmang.projectos.monolith.ProjectOsMonolithApplication</mainClass>
                    <classifier></classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
