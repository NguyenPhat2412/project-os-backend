POSTGRES_PASSWORD=replace-with-a-random-database-owner-password
JWT_SECRET=replace-with-at-least-32-random-characters
PROJECT_OS_ENV_FILE=/etc/project-os/project-os.env
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
OPENAPI_ENABLED=true
OPENAPI_PUBLIC=true
TRACING_SAMPLING_PROBABILITY=1.0
ZIPKIN_PORT=19411
POSTGRES_HOST_PORT=15433
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Host-side Java runs use 127.0.0.1; compose.monolith.yaml maps this to
# host.docker.internal automatically for the container-to-9Router connection.
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_KEY=replace-with-your-9router-api-key
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Administrator
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/login/oauth2/code/google
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3000/projects
MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-random-secret-key
EMAIL_WORKER_ENABLED=false
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_TIMEOUT_MS=15000
